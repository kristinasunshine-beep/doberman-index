{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doberman-index.com/schemas/registry.schema.json",
  "title": "Doberman Index Registry Record",
  "type": "object",
  "required": [
    "schema_version",
    "entity_type",
    "record_id",
    "status",
    "submission"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "entity_type": {
      "enum": [
        "doberman",
        "kennel",
        "litter"
      ]
    },
    "record_id": {
      "type": "string",
      "pattern": "^DI-(M|F|K|L)-[0-9]{6}$"
    },
    "status": {
      "enum": [
        "draft",
        "pending_review",
        "published",
        "archived"
      ]
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "submission": {
      "type": "object",
      "required": [
        "submitter_name",
        "submitter_email",
        "relationship",
        "consent_publication"
      ],
      "properties": {
        "submitter_name": {
          "type": "string"
        },
        "submitter_email": {
          "type": "string",
          "format": "email"
        },
        "relationship": {
          "enum": [
            "owner",
            "breeder",
            "kennel_representative",
            "trainer",
            "authorized_representative",
            "other"
          ]
        },
        "consent_publication": {
          "type": "boolean"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "doberman": {
      "$ref": "#/$defs/doberman"
    },
    "kennel": {
      "$ref": "#/$defs/kennel"
    },
    "litter": {
      "$ref": "#/$defs/litter"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "entity_type": {
            "const": "doberman"
          }
        }
      },
      "then": {
        "required": [
          "doberman"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "entity_type": {
            "const": "kennel"
          }
        }
      },
      "then": {
        "required": [
          "kennel"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "entity_type": {
            "const": "litter"
          }
        }
      },
      "then": {
        "required": [
          "litter"
        ]
      }
    }
  ],
  "$defs": {
    "focalPoint": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "galleryItem": {
      "type": "object",
      "required": [
        "path",
        "focal_point",
        "fit_mode"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^media/(dobermans|kennels|litters)/[^\\s]+\\.(jpg|jpeg|png|webp|avif)$"
        },
        "focal_point": {
          "$ref": "#/$defs/focalPoint"
