{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doberman-index-media-admin",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "vars": {
    "MEDIA_PUBLIC_BASE": "https://doberman-index-media-admin.dobermanindex-records.workers.dev"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "doberman-index-media"
    }
  ]
}
