name = "doberman-index-commerce"
main = "src/index.js"
compatibility_date = "2026-09-01"

[vars]
DODO_PAYMENTS_ENVIRONMENT = "live_mode"

[[kv_namespaces]]
binding = "COMMERCE_STATE"
id = "REPLACE_WITH_KV_NAMESPACE_ID"

# Set these as encrypted secrets, never in this file:
# wrangler secret put DODO_PAYMENTS_API_KEY
# wrangler secret put DODO_PAYMENTS_WEBHOOK_KEY
# wrangler secret put DODO_PRODUCT_INTELLIGENCE_RECORD
# wrangler secret put DODO_PRODUCT_KENNEL_PROMOTION
